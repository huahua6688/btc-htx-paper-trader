# Deployment-only settings. Never put HTX/Huobi credentials in this file.
PAPER_DB_PATH=/var/lib/btc-htx-paper/paper-trading.sqlite
PAPER_HEALTH_MAX_AGE_MS=900000
SHADOW_PAPER_ENABLED=true
SHADOW_DB_PATH=/var/lib/btc-htx-paper/shadow-challenger.sqlite

# This Chat ID is also the only administrator allowed to change Paper settings.
# Fill these on the VPS. Never commit the real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
